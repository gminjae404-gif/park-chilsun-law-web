# 홈페이지 상담신청(ConsultationForm) → 사무실 이메일 전송에 필요한
# 서버측 환경변수 목록입니다. 실제 값은 이 파일에 적지 말고, 로컬
# 개발에서만 필요하면 이 파일을 복사한 .env.local(Git에 커밋되지 않음)에
# 채워 넣거나, 실제 운영은 Vercel 프로젝트의
# Settings → Environment Variables에 직접 등록하세요.
#
# 아래 5개 값이 모두 채워져야 상담신청 폼이 실제로 이메일을 전송합니다.
# 하나라도 비어 있으면 폼은 자동으로 DEMO 모드로 동작하며(전송 시도
# 자체를 하지 않음), 화면에는 "준비 중" 안내만 표시됩니다.

# 상담 내용을 발송할 SMTP 서버 주소 (예: smtp.naver.com, smtp.gmail.com)
SMTP_HOST=

# SMTP 포트. 생략 시 465(SSL)로 동작합니다. STARTTLS를 쓰는 서비스는 587.
SMTP_PORT=465

# 발신 계정 로그인 아이디(보통 이메일 주소 그대로)
SMTP_USER=

# 발신 계정 비밀번호 또는 (Gmail 등에서 발급하는) 앱 비밀번호
SMTP_PASSWORD=

# 상담 내용을 실제로 받을 사무실 이메일 주소.
# 실제 운영값은 이 파일(레포지토리에 커밋됨)에 적지 않고, Vercel 프로젝트의
# Settings → Environment Variables에서만 등록·관리합니다.
CONSULTATION_RECEIVER_EMAIL=
